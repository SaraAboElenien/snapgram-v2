# Dependencies
node_modules/

# Environment variables / secrets
.env
.env.*
!.env.example
config/.env
# Dummy, non-secret values only (session keys, fake Cloudinary/email creds) —
# safe to commit, needed so the test suite works the same locally and in CI.
!backend/config/.env.test

# Build output
dist/
build/

# Test/coverage run artifacts (regenerated by every local test run)
coverage/
test-results/
playwright-report/

# Backend legacy local upload artifacts (not used by the active Cloudinary upload path)
backend/uploads/*
!backend/uploads/.gitkeep

# Logs
*.log
npm-debug.log*

# Editor/OS
.vscode/
.DS_Store
Thumbs.db

# Internal working docs (audit reports, ADR log, session status, scoping
# docs) — process artifacts for building this project, not meant to be
# public. README.md is the one markdown file that ships.
*.md
!README.md
