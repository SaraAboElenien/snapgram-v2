# Dummy, non-secret values for automated tests only — safe to commit.
# DB_URL is overridden at runtime by the test setup (mongodb-memory-server's
# ephemeral URI), so the placeholder below is never actually used to connect.
NODE_ENV=test
DB_URL=mongodb://127.0.0.1:27017/snapgram-test-placeholder
DB_URL_ONLINE=mongodb://127.0.0.1:27017/snapgram-test-placeholder

saltRounds=10
sessionKey=test-session-key-not-a-real-secret
confirmationKey=test-confirmation-key-not-a-real-secret
confirmationKeyRefresher=test-confirmation-refresher-key-not-a-real-secret

PORT=3000

sendEmail=test@example.com
emailPassword=test-not-a-real-password

CLOUDINARY_CLOUD_NAME=test-cloud
CLOUDINARY_API_KEY=test-cloudinary-key
CLOUDINARY_API_SECRET=test-cloudinary-secret

defaultProfilePic=https://example.com/placeholder-profile.png
defaultpuplicPic=test-default-profile-public-id
